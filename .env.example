# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
LOG_LEVEL=INFO
SENTIMENT_DATA_ROOT=../sentimentAI-data

# Local Compose services
DATABASE_URL=postgresql://sentiment:sentiment@localhost:5432/sentiment
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sentiment_chunks

# LLM provider
LLM_BACKEND=groq
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Embeddings
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
POC_FORCE_MOCK_EMBEDDINGS=0

# Metrics
PROMETHEUS_ENABLED=1
