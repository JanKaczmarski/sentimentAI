# Copy to .env for local development. Never commit real secrets.
APP_ENV=research
LOG_LEVEL=INFO
SENTIMENT_DATA_ROOT=../sentimentAI-data

# Local Compose services
DATABASE_URL=postgresql://sentiment:sentiment@localhost:5432/sentiment
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=research_chunks

# LLM provider
LLM_BACKEND=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b

# Embeddings
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
POC_FORCE_MOCK_EMBEDDINGS=0

# Metrics
PROMETHEUS_ENABLED=1
